# Any OpenAI-compatible endpoint: its base URL including the API prefix
# (for example http://localhost:8000/v1), but not /chat/completions.
OPENAI_BASE_URL=

# Credential sent to the endpoint. Leave empty if the endpoint needs none.
OPENAI_API_KEY=

# Model identifier accepted by the endpoint.
OPENAI_MODEL=

# Hosts that may receive your private notes without asking, comma-separated
# (include the port if the URL has one). Leave empty to be asked every time.
# A local model is a good candidate; which hosts each component may contact at all
# is set separately, in policy.rego (allowed_hosts).
PRIVATE_DATA_HOSTS=
