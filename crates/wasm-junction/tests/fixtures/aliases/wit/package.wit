package test:aliases;

interface shared {
  type count = u32;
}

interface aliases {
  use shared.{count as imported-count};
  type labels = list<string>;
  type character-pair = tuple<char, bool>;
  type outcome = result<u32, string>;
  type count-copy = imported-count;
  record alias-container {
    labels: labels,
    character-pair: character-pair,
    outcome: outcome,
    count: count-copy,
  }
}
