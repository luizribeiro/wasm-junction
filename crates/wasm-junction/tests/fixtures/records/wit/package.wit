package test:records;

interface notes {
  record coordinates { x: s32, y: s32 }
  record note {
    title: string,
    lines: list<string>,
    marker: option<char>,
    score: f32,
    position: coordinates,
  }
  record value-first { value: string, tail: u32 }
  record field-first { field: string, tail: u32 }
  record fields-first { fields: string, tail: u32 }
}
