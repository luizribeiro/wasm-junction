package test:keywords;

interface %super {
  record %self {
    %type: string,
    %match: bool,
    %self: string,
    %super: string,
    %crate: string,
  }

  host: func(cx: string) -> string;
  provider: func(call: string) -> string;
  call: func(call: string, args: string, value: string, host: string, %self: string) -> string;
  %super: func() -> string;
}
