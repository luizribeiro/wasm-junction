package test:wasi@0.1.0;

interface environment {
  read: func(name: string) -> option<string>;
  arguments: func() -> list<string>;
  current-directory: func() -> option<string>;
  wall-time: func() -> tuple<u64, u32>;
  monotonic-time: func() -> u64;
  start-timer: func();
  sleep: func();
  coverage: func();
  differential: func() -> string;
  refused-write: func() -> string;
  input-read: func() -> string;
  rewritten-write: func() -> bool;
  splice-first: func();
  stdout-channel: func();
  random-bytes: func() -> list<u8>;
  exit-success: func();
  exit-code: func();
  terminal-handles: func();
  benchmark-write: func(bytes: list<u8>) -> list<u8>;
  filesystem-coverage: func();
  directories: func() -> list<string>;
  read-file: func(path: string) -> result<string, string>;
  write-file: func(path: string, contents: string) -> result<_, string>;
  stat-preopen: func() -> result<_, string>;
  link-preopens: func();
  filesystem-channels: func();
  descriptor-handle: func() -> bool;
  directory-stream-handle: func() -> bool;
  filesystem-differential: func() -> string;
  sockets-denied: func() -> tuple<string, string>;
  tcp-echo: func(port: u16) -> result<string, string>;
  udp-echo: func(port: u16) -> result<string, string>;
  socket-differential: func(tcp-port: u16, udp-port: u16) -> result<string, string>;
  dns-probe: func(name: string) -> string;
  socket-handle: func() -> bool;
}

world fixture {
  export environment;
}
