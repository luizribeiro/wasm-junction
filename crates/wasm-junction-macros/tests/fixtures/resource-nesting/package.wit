package test:resources;

interface host {
  resource session {
    constructor();
    new: func();
    profile: func(session: string);
  }

  allowed: func(value: option<borrow<session>>) -> result<session, string>;
  consume: func(value: session);
  choose: func(value: result<borrow<session>, session>);
  bad: func(values: list<borrow<session>>);
}
