package example:value-streams@0.1.0;

interface host {
  accept-strings: async func(values: stream<string>);
  strings: func() -> stream<string>;
}

interface probe {
  exchange-strings: async func() -> list<string>;
  echo-strings: async func(values: stream<string>) -> list<string>;
  return-host-strings: func() -> stream<string>;
  echo-lists: async func(values: stream<list<u32>>) -> list<list<u32>>;
  echo-nested: async func(values: stream<list<option<string>>>) -> list<list<option<string>>>;
}

world value-streams {
  import host;
  export probe;
}
