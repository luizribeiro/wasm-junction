package example:reload@0.1.0;

interface gate {
  wait: async func();
}

interface greeter {
  greet: func(name: string) -> string;
  greet-slow: async func(name: string) -> string;
}

interface legacy {
  status: func() -> string;
}

interface writer {
  write: func(name: string) -> string;
}

world greeter-component {
  import gate;
  export greeter;
  export legacy;
}

world breaking-component {
  import gate;
  export legacy;
}

world writer-component {
  import greeter;
  export writer;
}
