package example:resources@1.0.0;

interface host {
    resource file;

    open-file: func(name: string) -> file;

    resource session {
        constructor(user: string);
        profile: func() -> string;
    }
}

interface client {
    use host.{file, session};

    run: func(trap: bool) -> string;
    retain: func() -> string;
    drop-after-refusal: func();
    inspect: func(value: borrow<session>) -> string;
    round-trip-file: func(value: file) -> file;
    round-trip: func(value: session) -> session;
    return-sessions: func() -> list<session>;
}

world resource-client {
    import host;
    export client;
}
